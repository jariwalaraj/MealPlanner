# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_TOKEN=your_access_token
PHONE_NUMBER_ID=your_phone_number_id
# Check the current Graph API version in your Meta dashboard
GRAPH_API_VERSION=v23.0

# Any string you choose; enter the same value when configuring the webhook in Meta
VERIFY_TOKEN=pick_a_random_string

# Meta App Dashboard > App settings > Basic > App secret (used to verify webhook signatures)
APP_SECRET=your_app_secret

PORT=3000
DB_PATH=menu.db
# Don't re-suggest an item within this many days (if alternatives exist)
SUGGEST_COOLDOWN_DAYS=3
